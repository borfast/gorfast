# Copy to .env and fill in TODO_CRYPT__KEYS. Environment variables override this file.

# Address to listen on. Keep it on localhost.
TODO_SERVER__ADDR=127.0.0.1:8080

# A postgres:// or postgresql:// URL, or the path of a SQLite file.
# For a database that is not on localhost, add sslmode=verify-full to the URL.
# Without it, or with sslmode=require, the server's TLS certificate is not checked.
TODO_DATABASE__URL=todo.db

# Comma-separated key specs. The first key seals new data, the others only open old data.
# Make one with: go run github.com/borfast/gorfast/crypt/cmd/newkey
TODO_CRYPT__KEYS=

# One of debug, info, warn, error.
TODO_LOG__LEVEL=info
